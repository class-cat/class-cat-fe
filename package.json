{
  "name": "class-cat-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:main": "turbo run dev --filter=@class-cat/main",
    "dev:business": "turbo run dev --filter=@class-cat/business",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.7.3",
    "typescript": "^5.4.2"
  },
  "packageManager": "bun@1.1.0"
}
